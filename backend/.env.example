# ===================================================================
# Family Car Reservation App - Backend Environment
# Copy to .env and fill in. NEVER commit .env.
# ===================================================================

PORT=5000

# Comma-separated list of origins allowed to call this API.
# In production put the real app URL here, not localhost.
CLIENT_URL=http://localhost:5173,http://localhost:4173

# Initial family code, used only until an admin changes it in the app.
# After the first change the value in the database wins.
FAMILY_CODE=1234

# Secret used to sign session tokens. Leave empty and the server generates a
# stable per-install secret automatically. Set it explicitly to keep sessions
# valid across a database reset, or when running more than one instance.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Google Gemini key for Hebrew NLP. Optional: without it the bot falls back to
# the built-in Hebrew parser, which handles the common phrasings on its own.
# Free key: https://aistudio.google.com/
GEMINI_API_KEY=

# WhatsApp: the family group id, e.g. 120363028391829@g.us
# Find it by connecting the bot and checking the server log for incoming chats.
WHATSAPP_FAMILY_GROUP_ID=

# Start the WhatsApp client as soon as the server boots (true/false).
# Keep false in development so you are not asked to scan a QR on every restart.
WHATSAPP_AUTO_START=false
